{
  "name": "control-caja",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start:local": "powershell -ExecutionPolicy Bypass -File tools/control-local.ps1 -Accion Iniciar"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {"node": ">=24.0.0"}
}
